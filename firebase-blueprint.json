{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "middleName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "login": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "subadmin", "teacher", "staff", "mustaqil_o_qituvchi", "student"] },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "birthDate": { "type": "string" },
        "address": { "type": "string" },
        "idx": { "type": "number" },
        "ball": { "type": "number" },
        "spentBalls": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "login"]
    },
    "DtmSubject": {
      "title": "DtmSubject",
      "description": "DTM subject definition with block type and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "blockType": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "blockType", "status"]
    },
    "DtmQuestion": {
      "title": "DtmQuestion",
      "description": "DTM test bank question",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subjectName": { "type": "string", "maxLength": 160 },
        "block": { "type": "string", "minLength": 1, "maxLength": 40 },
        "questionText": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "optionA": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "optionB": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "optionC": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "optionD": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "correctAnswer": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "topic": { "type": "string", "maxLength": 200 },
        "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "block", "questionText", "optionA", "optionB", "optionC", "optionD", "correctAnswer", "difficulty", "status"]
    },
    "DtmOrganization": {
      "title": "DtmOrganization",
      "description": "DTM participating organization / school",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "orgType": { "type": "string", "maxLength": 120 },
        "region": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "responsiblePerson": { "type": "string", "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "studentCount": { "type": "number" },
        "assignmentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "status"]
    },
    "DtmStudent": {
      "title": "DtmStudent",
      "description": "Internal DTM examinee with unique 7-digit ID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "numericId": { "type": "string", "pattern": "^[0-9]{7}$" },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organizationName": { "type": "string", "maxLength": 240 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "groupOrClass": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "block1SubjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "block1SubjectName": { "type": "string", "maxLength": 160 },
        "block2SubjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "block2SubjectName": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["numericId", "organizationId", "fullName", "block1SubjectId", "block2SubjectId"]
    },
    "DtmAssignment": {
      "title": "DtmAssignment",
      "description": "Immutable individual 60-question DTM test assignment snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "assignmentCode": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "isLatest": { "type": "boolean" },
        "organizationId": { "type": "string", "maxLength": 128 },
        "organizationName": { "type": "string", "maxLength": 240 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentNumericId": { "type": "string", "pattern": "^[0-9]{7}$" },
        "studentFullName": { "type": "string", "maxLength": 200 },
        "block1SubjectId": { "type": "string", "maxLength": 128 },
        "block1SubjectName": { "type": "string", "maxLength": 160 },
        "block2SubjectId": { "type": "string", "maxLength": 128 },
        "block2SubjectName": { "type": "string", "maxLength": 160 },
        "block1Questions": { "type": "array" },
        "block2Questions": { "type": "array" },
        "totalQuestions": { "type": "number" },
        "status": { "type": "string", "enum": ["GENERATED", "PDF_READY", "DOWNLOADED", "CHECKED", "CANCELLED", "SUPERSEDED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assignmentCode", "organizationId", "studentId", "studentNumericId", "block1SubjectId", "block2SubjectId", "block1Questions", "block2Questions", "totalQuestions", "status"]
    },
    "DtmAnswerSheet": {
      "title": "DtmAnswerSheet",
      "description": "Submitted or scanned DTM answer sheet linked to 7-digit student ID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentNumericId": { "type": "string", "pattern": "^[0-9]{7}$" },
        "studentId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "assignmentCode": { "type": "string", "maxLength": 64 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sourceType": { "type": "string", "enum": ["MANUAL", "OMR_CAMERA", "OMR_IMAGE", "OMR_PDF", "SCANNER"] },
        "answers": { "type": "object" },
        "status": { "type": "string", "enum": ["SUBMITTED", "CHECKED", "ERROR"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentNumericId", "studentId", "assignmentId", "sourceType", "answers", "status"]
    },
    "DtmResult": {
      "title": "DtmResult",
      "description": "Graded DTM result for an examinee assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentNumericId": { "type": "string", "pattern": "^[0-9]{7}$" },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "answerSheetId": { "type": "string", "maxLength": 128 },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "unansweredCount": { "type": "number" },
        "percentage": { "type": "number" },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organizationId", "studentId", "studentNumericId", "assignmentId", "totalQuestions", "correctCount", "wrongCount", "unansweredCount", "percentage", "score"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Profiles" },
    "/courses/{courseId}": { "schema": "object", "description": "Courses" },
    "/enrollments/{enrollmentId}": { "schema": "object", "description": "Enrollments" },
    "/tests/{testId}": { "schema": "object", "description": "Tests" },
    "/testResults/{resultId}": { "schema": "object", "description": "Results" },
    "/departments/{deptId}": { "schema": "object", "description": "Departments" },
    "/groups/{groupId}": { "schema": "object", "description": "Groups" },
    "/messages/{messageId}": { "schema": "object", "description": "Messages" },
    "/activityLogs/{logId}": { "schema": "object", "description": "Logs" },
    "/siteContent/{contentId}": { "schema": "object", "description": "Content" },
    "/counters/{counterId}": { "schema": "object", "description": "Counters" },
    "/dtmSubjects/{subjectId}": { "schema": "DtmSubject", "description": "DTM subjects" },
    "/dtmQuestions/{questionId}": { "schema": "DtmQuestion", "description": "DTM test bank questions" },
    "/dtmOrganizations/{orgId}": { "schema": "DtmOrganization", "description": "DTM organizations" },
    "/dtmStudents/{studentId}": { "schema": "DtmStudent", "description": "DTM examinees with 7-digit IDs" },
    "/dtmAssignments/{assignmentId}": { "schema": "DtmAssignment", "description": "DTM immutable test variant snapshots" },
    "/dtmAnswerSheets/{sheetId}": { "schema": "DtmAnswerSheet", "description": "DTM answer sheets" },
    "/dtmResults/{resultId}": { "schema": "DtmResult", "description": "DTM graded results" },
    "/dtmCounters/{counterId}": { "schema": "object", "description": "DTM atomic counters" }
  }
}
