rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') in ['shohdonar@gmail.com', 'elyorbek@admin.uz', 'elyorbek@gmail.com'] ||
        getUserRole() == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based helpers
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') 
        : '';
    }

    function isTeacher() {
      return isAdmin() || (isSignedIn() && getUserRole() in ['teacher', 'staff']);
    }

    // --- Global Admin Access ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isTeacher();
    }

    // --- Core Content Collections ---
    match /botConfig/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id} { allow read: if true; allow write: if isTeacher(); }
    match /departments/{id} { allow read: if true; allow write: if isTeacher(); }
    match /groups/{id} { allow read: if true; allow write: if isTeacher(); }
    match /tests/{id} { allow read: if true; allow update: if true; allow create, delete: if isTeacher(); }
    match /subjects/{id} { allow read: if true; allow write: if isTeacher(); }
    match /siteContent/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /billing/{id} { allow read: if isTeacher(); allow write: if isAdmin(); }
    match /counters/{id} { allow read: if true; allow write: if true; }
    match /test-connection/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; allow update: if true; allow create, delete: if isSignedIn(); }

    // --- Dynamic Data Collections ---
    match /enrollments/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /quiz_history/{id} {
      allow read, write: if true;
    }
    match /quiz_sessions/{id} {
      allow read, write: if true;
    }
    match /quiz_participants/{id} {
      allow read, write: if true;
    }

    match /testResults/{id} {
      allow read: if true;
      allow write: if true;
    }

    // --- Monitoring & Communication ---
    match /messages/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /telegram_users/{id} {
      allow read, write: if true;
    }

    match /telegram_user_states/{id} {
      allow read, write: if true;
    }

    match /payments/{id} {
      allow read, write: if true;
    }

    match /admin_notifications/{id} {
      allow read, write: if true;
    }

    match /activityLogs/{document=**} {
      allow read, write: if true;
    }
  }
}
