rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shohdonar@gmail.com' || 
        request.auth.token.email == 'elyorbek@admin.uz' || 
        request.auth.token.email == 'elyorbek@gmail.com'
      );
    }

    // Helper for DTM module RBAC (admins & subadmins verified via token or user profile role)
    function isDtmAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'subadmin', 'superadmin']
      );
    }

    function isDtmOrgUser(orgId) {
      return isSignedIn() &&
        orgId is string &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDtmOrganization == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dtmOrganizationId == orgId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deleted' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked';
    }

    function isAnyDtmOrgUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDtmOrganization == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dtmOrganizationId is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deleted' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked';
    }

    function isValidDtmId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDtmSubject(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.blockType is string && data.blockType.size() >= 1 && data.blockType.size() <= 40 &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        (!('isMandatory' in data) || data.isMandatory is bool) &&
        (!('mandatoryGroup' in data) || (data.mandatoryGroup is string && data.mandatoryGroup in ['', 'ONA_TILI', 'MATEMATIKA', 'TARIX'])) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500));
    }

    function isValidDtmQuestion(data) {
      return data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 &&
        data.block is string && data.block.size() >= 1 && data.block.size() <= 40 &&
        data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 4000 &&
        data.optionA is string && data.optionA.size() >= 1 && data.optionA.size() <= 1500 &&
        data.optionB is string && data.optionB.size() >= 1 && data.optionB.size() <= 1500 &&
        data.optionC is string && data.optionC.size() >= 1 && data.optionC.size() <= 1500 &&
        data.optionD is string && data.optionD.size() >= 1 && data.optionD.size() <= 1500 &&
        data.correctAnswer in ['A', 'B', 'C', 'D'] &&
        data.difficulty in ['EASY', 'MEDIUM', 'HARD'] &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        (!('isMandatory' in data) || data.isMandatory is bool) &&
        (!('mandatoryGroup' in data) || (data.mandatoryGroup is string && data.mandatoryGroup in ['', 'ONA_TILI', 'MATEMATIKA', 'TARIX'])) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 200));
    }

    function isValidDtmOrganization(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 240 &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        (!('orgType' in data) || (data.orgType is string && data.orgType.size() <= 120)) &&
        (!('region' in data) || (data.region is string && data.region.size() <= 120)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('responsiblePerson' in data) || (data.responsiblePerson is string && data.responsiblePerson.size() <= 160)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1500));
    }

    function isValidDtmStudent(data) {
      return data.numericId is string && data.numericId.matches('^[0-9]{7}$') &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&
        data.block1SubjectId is string && data.block1SubjectId.size() >= 1 && data.block1SubjectId.size() <= 128 &&
        data.block2SubjectId is string && data.block2SubjectId.size() >= 1 && data.block2SubjectId.size() <= 128 &&
        (!('groupOrClass' in data) || (data.groupOrClass is string && data.groupOrClass.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidDtmAssignment(data) {
      return data.assignmentCode is string && data.assignmentCode.size() >= 3 && data.assignmentCode.size() <= 64 &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.studentNumericId is string && data.studentNumericId.matches('^[0-9]{7}$') &&
        data.block1SubjectId is string && data.block1SubjectId.size() >= 1 && data.block1SubjectId.size() <= 128 &&
        data.block2SubjectId is string && data.block2SubjectId.size() >= 1 && data.block2SubjectId.size() <= 128 &&
        data.block1Questions is list && data.block1Questions.size() == 30 &&
        data.block2Questions is list && data.block2Questions.size() == 30 &&
        (
          (data.totalQuestions == 60 && (!('mandatoryQuestions' in data) || data.mandatoryQuestions.size() == 0)) ||
          (data.totalQuestions == 90 && 'mandatoryQuestions' in data && data.mandatoryQuestions is list && data.mandatoryQuestions.size() == 30)
        ) &&
        data.status in ['GENERATED', 'PDF_READY', 'DOWNLOADED', 'CHECKED', 'CANCELLED', 'SUPERSEDED'];
    }

    function isValidDtmAnswerSheet(data) {
      return data.studentNumericId is string && data.studentNumericId.matches('^[0-9]{7}$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.assignmentId is string && data.assignmentId.size() >= 1 && data.assignmentId.size() <= 128 &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.sourceType in ['MANUAL', 'OMR_CAMERA', 'OMR_IMAGE', 'OMR_PDF', 'SCANNER'] &&
        data.answers is map &&
        data.status in ['SUBMITTED', 'CHECKED', 'ERROR'];
    }

    function isValidDtmResult(data) {
      return data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.studentNumericId is string && data.studentNumericId.matches('^[0-9]{7}$') &&
        data.assignmentId is string && data.assignmentId.size() >= 1 && data.assignmentId.size() <= 128 &&
        data.totalQuestions is number && data.totalQuestions in [60, 90] &&
        (!('mandatoryCorrect' in data) || data.mandatoryCorrect is number) &&
        (!('maxScore' in data) || data.maxScore is number) &&
        data.correctCount is number && data.wrongCount is number && data.unansweredCount is number &&
        data.percentage is number && data.score is number;
    }

    // Global admin rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Core content
    match /botConfig/{id} { allow read, write: if true; }
    match /courses/{id} { allow read, write: if true; }
    match /departments/{id} { allow read, write: if true; }
    match /groups/{id} { allow read, write: if true; }
    match /tests/{id} { allow read, write: if true; }
    match /subjects/{id} { allow read, write: if true; }
    match /siteContent/{id} { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
    match /system_settings/{id} { allow read, write: if true; }
    match /billing/{id} { allow read, write: if true; }
    match /counters/{id} { allow read, write: if true; }
    match /test-connection/{id} { allow read, write: if true; }
    match /certificates/{id} { allow read, write: if true; }
    match /faculties/{id} { allow read, write: if true; }
    match /academic_years/{id} { allow read, write: if true; }
    match /trash_bin/{id} { allow read, write: if true; }
    match /system_logs/{id} { allow read, write: if true; }
    match /computer_services/{id} { allow read, write: if true; }
    match /ai_services_costs/{id} { allow read, write: if true; }

    // Dynamic data
    match /enrollments/{id} { allow read, write: if true; }
    match /quiz_history/{id} { allow read, write: if true; }
    match /quiz_sessions/{id} { allow read, write: if true; }
    match /quiz_participants/{id} { allow read, write: if true; }
    match /testResults/{id} { allow read, write: if true; }

    // Monitoring & communication
    match /messages/{id} { allow read, write: if true; }
    match /telegram_users/{id} { allow read, write: if true; }
    match /telegram_user_states/{id} { allow read, write: if true; }
    match /payments/{id} { allow read, write: if true; }
    match /admin_notifications/{id} { allow read, write: if true; }
    
    // Connection requests
    match /connection_requests/{id} {
      allow read, write: if true;
    }

    // Payment history
    match /payment_history/{id} {
      allow read, write: if true;
    }
    match /payment_transactions/{id} {
      allow read, write: if true;
    }

    match /active_subscriptions/{id} {
      allow read, write: if true;
    }

    match /auto_tests/{id} { allow read, write: if true; }
    match /auto_test_results/{id} { allow read, write: if true; }

    // Activity logs
    match /activityLogs/{document=**} {
      allow read, write: if true;
    }

    // =====================================================
    // DTM TIZIM MODULE COLLECTIONS (Admin + Scoped DTM Org RBAC)
    // =====================================================
    match /dtmCounters/{counterId} {
      allow get: if isValidDtmId(counterId);
      allow list: if isDtmAdmin();
      allow create, update: if (
        isDtmAdmin() ||
        isAnyDtmOrgUser() ||
        counterId in ['student_numeric_id', 'assignment_seq_2026']
      ) && isValidDtmId(counterId) &&
        incoming().nextValue is int && incoming().nextValue >= 1;
      allow delete: if false;
    }

    match /dtmSubjects/{subjectId} {
      allow get: if isValidDtmId(subjectId);
      allow list: if true;
      allow create: if isDtmAdmin() && isValidDtmId(subjectId) && isValidDtmSubject(incoming());
      allow update: if isDtmAdmin() && isValidDtmId(subjectId) && isValidDtmSubject(incoming());
      allow delete: if isDtmAdmin() && isValidDtmId(subjectId);
    }

    match /dtmQuestions/{questionId} {
      allow get: if isValidDtmId(questionId);
      allow list: if true;
      allow create: if isDtmAdmin() && isValidDtmId(questionId) && isValidDtmQuestion(incoming());
      allow update: if isDtmAdmin() && isValidDtmId(questionId) && isValidDtmQuestion(incoming());
      allow delete: if isDtmAdmin() && isValidDtmId(questionId);
    }

    match /dtmOrganizations/{orgId} {
      allow get: if (isDtmAdmin() || isDtmOrgUser(orgId)) && isValidDtmId(orgId);
      allow list: if isDtmAdmin();
      allow create: if isDtmAdmin() && isValidDtmId(orgId) && isValidDtmOrganization(incoming());
      allow update: if (
        isDtmAdmin() ||
        (isDtmOrgUser(orgId) &&
          (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid) &&
          incoming().status == existing().status)
      ) && isValidDtmId(orgId) && isValidDtmOrganization(incoming());
      allow delete: if isDtmAdmin() && isValidDtmId(orgId);
    }

    match /dtmStudents/{studentId} {
      allow get: if isValidDtmId(studentId);
      allow list: if true;
      allow create: if (isDtmAdmin() || isDtmOrgUser(incoming().organizationId)) &&
        isValidDtmId(studentId) && isValidDtmStudent(incoming());
      allow update: if (
        isDtmAdmin() ||
        (isDtmOrgUser(existing().organizationId) && incoming().organizationId == existing().organizationId)
      ) && isValidDtmId(studentId) && isValidDtmStudent(incoming()) &&
        incoming().numericId == existing().numericId;
      allow delete: if (isDtmAdmin() || isDtmOrgUser(existing().organizationId)) && isValidDtmId(studentId);
    }

    match /dtmAssignments/{assignmentId} {
      allow get: if isValidDtmId(assignmentId);
      allow list: if true;
      allow create: if (
        isDtmAdmin() ||
        isDtmOrgUser(incoming().organizationId) ||
        incoming().organizationId == 'telegram_bot'
      ) && isValidDtmId(assignmentId) && isValidDtmAssignment(incoming());
      allow update: if (
        isDtmAdmin() ||
        (isDtmOrgUser(existing().organizationId) && incoming().organizationId == existing().organizationId) ||
        (existing().organizationId == 'telegram_bot' && incoming().organizationId == 'telegram_bot')
      ) && isValidDtmId(assignmentId) && isValidDtmAssignment(incoming()) &&
        incoming().assignmentCode == existing().assignmentCode &&
        incoming().studentId == existing().studentId &&
        incoming().studentNumericId == existing().studentNumericId &&
        (!('mandatoryQuestions' in existing()) || incoming().mandatoryQuestions == existing().mandatoryQuestions) &&
        incoming().block1Questions == existing().block1Questions &&
        incoming().block2Questions == existing().block2Questions;
      allow delete: if false; // Preserve historical snapshots
    }

    match /dtmAnswerSheets/{sheetId} {
      allow get: if isValidDtmId(sheetId);
      allow list: if true;
      allow create: if (
        isDtmAdmin() ||
        isDtmOrgUser(incoming().organizationId) ||
        incoming().organizationId == 'telegram_bot'
      ) && isValidDtmId(sheetId) && isValidDtmAnswerSheet(incoming());
      allow update: if (
        isDtmAdmin() ||
        (isDtmOrgUser(existing().organizationId) && incoming().organizationId == existing().organizationId) ||
        (existing().organizationId == 'telegram_bot' && incoming().organizationId == 'telegram_bot')
      ) && isValidDtmId(sheetId) && isValidDtmAnswerSheet(incoming());
      allow delete: if false;
    }

    match /dtmResults/{resultId} {
      allow get: if isValidDtmId(resultId);
      allow list: if true;
      allow create: if (
        isDtmAdmin() ||
        isDtmOrgUser(incoming().organizationId) ||
        incoming().organizationId == 'telegram_bot'
      ) && isValidDtmId(resultId) && isValidDtmResult(incoming());
      allow update: if (
        isDtmAdmin() ||
        (isDtmOrgUser(existing().organizationId) && incoming().organizationId == existing().organizationId) ||
        (existing().organizationId == 'telegram_bot' && incoming().organizationId == 'telegram_bot')
      ) && isValidDtmId(resultId) && isValidDtmResult(incoming());
      allow delete: if false;
    }

    // Global admin rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
