# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_API_KEYS: Comma-separated alternative pool of Gemini API keys for the rotation mechanism.
GEMINI_API_KEYS=

# TELEGRAM_BOT_TOKEN: The Telegram Bot API token configured via BotFather.
TELEGRAM_BOT_TOKEN=

# APP_URL: The URL where this applet is hosted (e.g. https://aiedutizim.vercel.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# USE_WEBHOOK: Set to true to use Telegram webhooks instead of long polling.
# Requires APP_URL to be set correctly.
USE_WEBHOOK=false

# FIREBASE_API_KEY: Optional override for Firebase API key
FIREBASE_API_KEY=

# FIREBASE_PROJECT_ID: Optional override for Firebase Project ID
FIREBASE_PROJECT_ID=

# FIREBASE_AUTH_DOMAIN: Optional override for Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=

# FIREBASE_STORAGE_BUCKET: Optional override for Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=

# FIREBASE_MESSAGING_SENDER_ID: Optional override for Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=

# FIREBASE_APP_ID: Optional override for Firebase App ID
FIREBASE_APP_ID=

# DISABLE_HMR: Set to true if hot module replacement is disabled.
DISABLE_HMR=true

# DATABASE_URL: PostgreSQL connection string (Railway primary connection)
# Example: postgresql://user:password@host:port/database
DATABASE_URL=

# PGHOST: PostgreSQL host
PGHOST=

# PGPORT: PostgreSQL port
PGPORT=5432

# PGUSER: PostgreSQL username
PGUSER=

# PGPASSWORD: PostgreSQL password
PGPASSWORD=

# PGDATABASE: PostgreSQL database name
PGDATABASE=

# CLICK_SECRET_KEY & CLICK_SERVICE_ID: Click Merchant API credentials
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=

# PAYME_MERCHANT_KEY: Payme Merchant API secret key
PAYME_MERCHANT_KEY=
