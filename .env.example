# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_API_KEYS: Comma-separated alternative pool of Gemini API keys for the rotation mechanism.
GEMINI_API_KEYS=

# TELEGRAM_BOT_TOKEN: The Telegram Bot API token configured via BotFather.
TELEGRAM_BOT_TOKEN=

# APP_URL: The URL where this applet is hosted (e.g. your Railway project Domain).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# DISABLE_HMR: Set to true if hot module replacement is disabled.
DISABLE_HMR=true

# DATABASE_URL: Railway internal or general PostgreSQL URL for database connection.
DATABASE_URL=

# DATABASE_PUBLIC_URL: Railway public PostgreSQL URL used for external connections.
DATABASE_PUBLIC_URL=
